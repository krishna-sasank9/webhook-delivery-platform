# API
API_PORT=3000
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=jobqueue
PGPASSWORD=job
PGDATABASE=jobqueue

# Rate limit (M6) — per-webhook token bucket. Optional; defaults shown.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# Circuit breaker (M7) — per-webhook. Optional; defaults shown.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000